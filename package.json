{
  "name": "skills-desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.20.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "allowScripts": {
    "electron-winstaller@5.4.4": true,
    "electron@43.4.1": true
  },
  "overrides": {
    "extract-zip": "npm:@electron-internal/extract-zip@1.0.5",
    "tar": "7.5.22",
    "tmp": "0.2.7"
  },
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "candidate:build": "node scripts/release/build-candidate.mjs",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "check:imports": "node scripts/check-imports.mjs",
    "verify": "npm run typecheck && npm run lint && npm run check:imports && npm run test:coverage && npm run build",
    "smoke:cli": "vitest run --config vitest.smoke.config.ts tests/real-cli.smoke.test.ts",
    "smoke:ssh": "vitest run --config vitest.ssh-smoke.config.ts",
    "package:linux": "npm run build && npm exec --workspace @skills-desktop/desktop electron-forge package -- --platform=linux --arch=x64",
    "smoke:packaged": "npm run package:linux && xvfb-run -a node tests/packaged-electron.smoke.mjs",
    "qa:packaged-ui": "node tests/packaged-ui-qa/run.mjs",
    "qa:packaged-ui:linux": "npm run package:linux && xvfb-run -a node tests/packaged-ui-qa/run.mjs",
    "lint:biome": "npx --yes @biomejs/biome@1.9.4 check apps/desktop/src"
  },
  "devDependencies": {
    "@babel/core": "8.0.1",
    "@babel/eslint-parser": "8.0.1",
    "@babel/parser": "8.0.4",
    "@eslint/js": "9.39.5",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.2",
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.1.0",
    "@vitest/coverage-v8": "4.1.11",
    "axe-core": "4.13.0",
    "eslint": "9.39.5",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.11.0",
    "jsdom": "30.0.1",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "vitest": "4.1.11",
    "yaml": "2.9.0"
  }
}
